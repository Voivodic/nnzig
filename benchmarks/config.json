{
    "dataset": {
        "file": "dataset_benchmark.bin",
        "num_points": 100,
        "seed": 12345
    },
    "outputs": {
        "losses_zig": "losses/losses_zig.bin",
        "losses_pytorch": "losses/losses_pytorch.bin",
        "losses_equinox": "losses/losses_equinox.bin",
        "losses_tensorflow": "losses/losses_tensorflow.bin",
        "losses_plot": "plots/losses_plot.png",
        "resources_nnzig": "resources/resources_nnzig.json",
        "resources_nnzig_b1": "resources/resources_nnzig_b1.json",
        "resources_pytorch": "resources/resources_pytorch.json",
        "resources_equinox": "resources/resources_equinox.json",
        "resources_tensorflow": "resources/resources_tensorflow.json",
        "resources_plot": "plots/resources_plot.png"
    },
    "network": {
        "precision": 32,
        "numThreads": 24,
        "nNeurons": [128, 256, 256, 128],
        "activations": ["relu", "relu", "none"],
        "lossFunc": "MSE",
        "normalization": "meanStd"
    },
    "training": {
        "seed": 13,
        "rTrain": 0.7,
        "rVal": 0.2,
        "eps": 1e-8,
        "beta1": 0.9,
        "beta2": 0.999,
        "lr": 0.01,
        "nEpochs": 500,
        "batchSize": 50,
        "batchSizeCompute": 50,
        "printEvery": 0
    }
}
