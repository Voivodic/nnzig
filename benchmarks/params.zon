.{
    .precision = 32,
    .numThreads = 10,
    .nNeurons = .{ 128, 256, 256, 128 },
    .activations = .{ "relu", "relu", "none" },
    .lossFunc = "MSE",
    .normalization = "meanStd",
    .seed = 13,
    .rTrain = 0.7,
    .rVal = 0.2,
    .eps = 1e-08,
    .beta1 = 0.9,
    .beta2 = 0.999,
    .lr = 0.01,
    .nEpochs = 500,
    .batchSize = 50,
    .batchSizeCompute = 50,
    .printEvery = 0,
}
